import std.string
from std.test import assert_eq_str, assert_eq_int, assert_true, assert_false
from "github.com/martian56/plumage/text" import Line
from "./lib" import render, plain
from "./theme" import MdTheme, default_theme

fun texts(lines: list[Line]) -> list[str] {
    let out: list[str] = []
    var i = 0
    while i < lines.len() {
        out.push(plain(lines[i]))
        i = i + 1
    }
    return out
}

fun joined(lines: list[Line]) -> str {
    var out = ""
    let t = texts(lines)
    var i = 0
    while i < t.len() {
        out = "${out}|${t[i]}"
        i = i + 1
    }
    return out
}

fun test_paragraph_wraps_at_the_width() {
    let lines = render("one two three four five", 12, default_theme())
    assert_eq_str(joined(lines), "|one two|three four|five")
}

fun test_heading_strips_the_marks_and_styles_the_text() {
    let lines = render("## Section title", 40, default_theme())
    assert_eq_int(lines.len(), 1)
    assert_eq_str(plain(lines[0]), "Section title")
    assert_true(lines[0].spans[0].style.bold)
}

fun test_bold_italic_and_code_spans_carry_styles() {
    let lines = render("a **b** *c* `d` e", 60, default_theme())
    assert_eq_int(lines.len(), 1)
    assert_eq_str(plain(lines[0]), "a b c d e")
    // Find the styled words by text.
    var saw_bold = false
    var saw_italic = false
    var saw_code = false
    var i = 0
    while i < lines[0].spans.len() {
        let sp = lines[0].spans[i]
        if sp.text.contains("b") and sp.style.bold {
            saw_bold = true
        }
        if sp.text.contains("c") and sp.style.italic {
            saw_italic = true
        }
        if sp.text.contains("d") and sp.style.underline {
            saw_code = true
        }
        i = i + 1
    }
    assert_true(saw_bold)
    assert_true(saw_italic)
    assert_true(saw_code)
}

fun test_snake_case_and_arithmetic_stay_literal() {
    let lines = render("file_name and 2 * 3", 60, default_theme())
    assert_eq_str(plain(lines[0]), "file_name and 2 * 3")
}

fun test_fenced_code_is_verbatim_and_indented() {
    let lines = render("```\nlet x = 1\n```", 40, default_theme())
    assert_eq_str(joined(lines), "|  let x = 1")
}

fun test_unclosed_fence_renders_as_code() {
    // A streaming reply mid-chunk: the closing fence has not arrived yet.
    let lines = render("```\npartial line", 40, default_theme())
    assert_eq_str(joined(lines), "|  partial line")
}

fun test_long_code_lines_hard_split() {
    let lines = render("```\naaaaaaaaaabbbbbbbbbb\n```", 12, default_theme())
    assert_eq_str(joined(lines), "|  aaaaaaaaaa|  bbbbbbbbbb")
}

fun test_bullets_wrap_with_a_hanging_indent() {
    let lines = render("- one two three four", 13, default_theme())
    assert_eq_str(joined(lines), "|• one two|  three four")
}

fun test_nested_bullets_keep_their_indentation() {
    let lines = render("- top\n  - inner", 40, default_theme())
    assert_eq_str(joined(lines), "|• top|  • inner")
}

fun test_numbered_lists_align_their_continuations() {
    let lines = render("1. alpha beta gamma", 12, default_theme())
    assert_eq_str(joined(lines), "|1. alpha|   beta|   gamma")
}

fun test_blockquote_carries_a_bar() {
    let lines = render("> quoted words", 40, default_theme())
    assert_eq_str(plain(lines[0]), "▎ quoted words")
}

fun test_rule_spans_the_width() {
    let lines = render("---", 8, default_theme())
    assert_eq_str(plain(lines[0]), "────────")
}

fun test_links_show_label_and_url() {
    let lines = render("[docs](https://x.dev)", 60, default_theme())
    assert_eq_str(plain(lines[0]), "docs (https://x.dev)")
}

fun test_blank_lines_collapse() {
    let lines = render("a\n\n\n\nb", 40, default_theme())
    assert_eq_str(joined(lines), "|a||b")
}

fun test_over_wide_word_splits_instead_of_overflowing() {
    let lines = render("aaaaaaaaaaaaaaaaaaaa", 10, default_theme())
    assert_eq_str(joined(lines), "|aaaaaaaaaa|aaaaaaaaaa")
}

fun test_punctuation_stays_attached_to_styled_runs() {
    let lines = render("**bold**, then *it*.", 60, default_theme())
    assert_eq_str(plain(lines[0]), "bold, then it.")
}

fun test_strikethrough_strips_markers_and_strikes() {
    let lines = render("a ~~gone~~ b", 60, default_theme())
    assert_eq_str(plain(lines[0]), "a gone b")
    var saw = false
    var i = 0
    while i < lines[0].spans.len() {
        if lines[0].spans[i].text.contains("gone") and lines[0].spans[i].style.strike {
            saw = true
        }
        i = i + 1
    }
    assert_true(saw)
}

fun test_task_list_renders_checkboxes() {
    let lines = render("- [x] done thing\n- [ ] open thing", 40, default_theme())
    assert_eq_str(plain(lines[0]), "☑ done thing")
    assert_eq_str(plain(lines[1]), "☐ open thing")
}

fun test_table_renders_aligned_columns() {
    let md = "| Name | Count |\n|---|---:|\n| a | 1 |\n| longer | 22 |"
    let lines = render(md, 60, default_theme())
    // Header, rule, two body rows.
    assert_eq_int(lines.len(), 4)
    assert_eq_str(plain(lines[0]), "Name   │ Count")
    assert_eq_str(plain(lines[1]), "───────┼──────")
    // The Count column is right-aligned.
    assert_eq_str(plain(lines[2]), "a      │     1")
    assert_eq_str(plain(lines[3]), "longer │    22")
}

fun test_table_cells_parse_inline_markup() {
    let md = "| A |\n|---|\n| `code` |"
    let lines = render(md, 60, default_theme())
    // Backticks consumed; the cell shows the code text.
    assert_eq_str(plain(lines[2]), "code")
}

fun test_table_without_separator_is_still_a_table() {
    let md = "| x | y |\n| 1 | 2 |"
    let lines = render(md, 60, default_theme())
    assert_eq_int(lines.len(), 2)
    assert_eq_str(plain(lines[0]), "x │ y")
    assert_eq_str(plain(lines[1]), "1 │ 2")
}

fun test_wide_table_clips_at_the_width() {
    let md = "| aaaaaaaaaa | bbbbbbbbbb |\n|---|---|\n| 1 | 2 |"
    let lines = render(md, 14, default_theme())
    var i = 0
    while i < lines.len() {
        assert_true(plain(lines[i]).length() <= 14 * 3)
        i = i + 1
    }
}

fun test_escaped_pipe_stays_inside_its_cell() {
    let md = "| a | b |\n|---|---|\n| pipes \\| here | 2 |"
    let lines = render(md, 60, default_theme())
    // Still a two-column grid, with the literal pipe inside the first cell.
    assert_eq_int(lines.len(), 3)
    assert_true(plain(lines[2]).contains("pipes | here"))
    assert_true(plain(lines[2]).contains("│ 2"))
}

fun test_quote_nests_block_markdown() {
    let md = "> ### Inside\n>\n> - item one\n> - item two"
    let lines = render(md, 40, default_theme())
    // The heading loses its marks and the bullets render, all behind the bar.
    assert_eq_str(plain(lines[0]), "▎ Inside")
    assert_eq_str(plain(lines[1]), "▎ ")
    assert_eq_str(plain(lines[2]), "▎ • item one")
    assert_eq_str(plain(lines[3]), "▎ • item two")
}

fun test_diff_fence_styles_added_and_removed_lines() {
    let md = "```diff\n- old = false\n+ new = true\n```"
    let lines = render(md, 40, default_theme())
    assert_eq_str(plain(lines[0]), "  - old = false")
    assert_eq_str(plain(lines[1]), "  + new = true")
    // default_theme marks removals with strike and additions bold.
    assert_true(lines[0].spans[1].style.strike)
    assert_true(lines[1].spans[1].style.bold)
}
