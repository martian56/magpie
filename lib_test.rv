import std/string
import std/test { assert_eq_str, assert_eq_int, assert_true, assert_false }
import "github.com/martian56/plumage/text" { Line }
import "./lib" { render, plain }
import "./theme" { MdTheme, default_theme }

fun texts(lines: List<Line>) -> List<String> {
    let out: List<String> = []
    let i = 0
    while i < lines.len() {
        out.push(plain(lines[i]))
        i = i + 1
    }
    return out
}

fun joined(lines: List<Line>) -> String {
    let out = ""
    let t = texts(lines)
    let i = 0
    while i < t.len() {
        out = "${out}|${t[i]}"
        i = i + 1
    }
    return out
}

fun test_paragraph_wraps_at_the_width() {
    let lines = render("one two three four five", 12, default_theme())
    assert_eq_str(joined(lines), "|one two|three four|five")
}

fun test_heading_strips_the_marks_and_styles_the_text() {
    let lines = render("## Section title", 40, default_theme())
    assert_eq_int(lines.len(), 1)
    assert_eq_str(plain(lines[0]), "Section title")
    assert_true(lines[0].spans[0].style.bold)
}

fun test_bold_italic_and_code_spans_carry_styles() {
    let lines = render("a **b** *c* `d` e", 60, default_theme())
    assert_eq_int(lines.len(), 1)
    assert_eq_str(plain(lines[0]), "a b c d e")
    // Find the styled words by text.
    let saw_bold = false
    let saw_italic = false
    let saw_code = false
    let i = 0
    while i < lines[0].spans.len() {
        let sp = lines[0].spans[i]
        if sp.text.contains("b") && sp.style.bold {
            saw_bold = true
        }
        if sp.text.contains("c") && sp.style.italic {
            saw_italic = true
        }
        if sp.text.contains("d") && sp.style.underline {
            saw_code = true
        }
        i = i + 1
    }
    assert_true(saw_bold)
    assert_true(saw_italic)
    assert_true(saw_code)
}

fun test_snake_case_and_arithmetic_stay_literal() {
    let lines = render("file_name and 2 * 3", 60, default_theme())
    assert_eq_str(plain(lines[0]), "file_name and 2 * 3")
}

fun test_fenced_code_is_verbatim_and_indented() {
    let lines = render("```\nlet x = 1\n```", 40, default_theme())
    assert_eq_str(joined(lines), "|  let x = 1")
}

fun test_unclosed_fence_renders_as_code() {
    // A streaming reply mid-chunk: the closing fence has not arrived yet.
    let lines = render("```\npartial line", 40, default_theme())
    assert_eq_str(joined(lines), "|  partial line")
}

fun test_long_code_lines_hard_split() {
    let lines = render("```\naaaaaaaaaabbbbbbbbbb\n```", 12, default_theme())
    assert_eq_str(joined(lines), "|  aaaaaaaaaa|  bbbbbbbbbb")
}

fun test_bullets_wrap_with_a_hanging_indent() {
    let lines = render("- one two three four", 13, default_theme())
    assert_eq_str(joined(lines), "|• one two|  three four")
}

fun test_nested_bullets_keep_their_indentation() {
    let lines = render("- top\n  - inner", 40, default_theme())
    assert_eq_str(joined(lines), "|• top|  • inner")
}

fun test_numbered_lists_align_their_continuations() {
    let lines = render("1. alpha beta gamma", 12, default_theme())
    assert_eq_str(joined(lines), "|1. alpha|   beta|   gamma")
}

fun test_blockquote_carries_a_bar() {
    let lines = render("> quoted words", 40, default_theme())
    assert_eq_str(plain(lines[0]), "▎ quoted words")
}

fun test_rule_spans_the_width() {
    let lines = render("---", 8, default_theme())
    assert_eq_str(plain(lines[0]), "────────")
}

fun test_links_show_label_and_url() {
    let lines = render("[docs](https://x.dev)", 60, default_theme())
    assert_eq_str(plain(lines[0]), "docs (https://x.dev)")
}

fun test_blank_lines_collapse() {
    let lines = render("a\n\n\n\nb", 40, default_theme())
    assert_eq_str(joined(lines), "|a||b")
}

fun test_over_wide_word_splits_instead_of_overflowing() {
    let lines = render("aaaaaaaaaaaaaaaaaaaa", 10, default_theme())
    assert_eq_str(joined(lines), "|aaaaaaaaaa|aaaaaaaaaa")
}

fun test_punctuation_stays_attached_to_styled_runs() {
    let lines = render("**bold**, then *it*.", 60, default_theme())
    assert_eq_str(plain(lines[0]), "bold, then it.")
}
