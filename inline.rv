// Inline markdown: **bold**, *italic*, `code`, and [text](url) parsed into
// styled spans, plus the span-aware word wrap that lays those spans out at a
// width. Both are pure, so the whole renderer is testable without a
// terminal.

import std.string
from "github.com/martian56/wingspan" import decode, width
from "github.com/martian56/plumage/text" import Span, Line
from "github.com/martian56/plumage/style" import Style
from "./theme" import MdTheme

// Parse one run of text (a paragraph, a heading, a list item) into styled
// spans. `base` is the style for unmarked text, so a blockquote can parse
// with its own base while bold and code keep their meaning.
//
// Rules kept deliberately small: ** toggles bold, ~~ toggles strikethrough,
// * toggles italic when it hugs a word (so "2 * 3" stays literal), backticks
// span code verbatim, and
// [text](url) renders the text in the link style with the URL after it. An
// unclosed backtick runs code to the end of the text, which is what a
// streaming reply looks like mid-chunk. Underscores are always literal:
// agent answers are full of snake_case.
fun parse_inline(text: str, th: MdTheme, base: Style) -> list[Span] {
    let out: list[Span] = []
    var run = ""
    var bold = false
    var italic = false
    var strike = false
    var i = 0
    let n = text.length()
    while i < n {
        let step = _marker(text, i, italic)
        if step == 1 {
            run = _flush(out, run, _run_style(th, base, bold, italic, strike))
            strike = not strike
            i = i + 2
        } else {
            if step == 2 {
                run = _flush(out, run, _run_style(th, base, bold, italic, strike))
                bold = not bold
                i = i + 2
            } else {
                if step == 3 {
                    run = _flush(out, run, _run_style(th, base, bold, italic, strike))
                    italic = not italic
                    i = i + 1
                } else {
                    if step == 4 {
                        run = _flush(out, run, _run_style(th, base, bold, italic, strike))
                        let close = _find(text, "`", i + 1)
                        if close < 0 {
                            out.push(Span.styled(text.substring(i + 1, n), th.code))
                            i = n
                        } else {
                            out.push(Span.styled(text.substring(i + 1, close), th.code))
                            i = close + 1
                        }
                    } else {
                        if step == 5 {
                            let link = _parse_link(text, i)
                            if link.ok {
                                run = _flush(out, run, _run_style(th, base, bold, italic, strike))
                                out.push(Span.styled(link.label, th.link))
                                if link.url != "" and link.url != link.label {
                                    out.push(Span.styled(" (${link.url})", th.url))
                                }
                                i = link.next
                            } else {
                                run = run.concat("[")
                                i = i + 1
                            }
                        } else {
                            let c = decode(text, i)
                            run = run.concat(text.substring(i, i + c.size))
                            i = i + c.size
                        }
                    }
                }
            }
        }
    }
    let _ = _flush(out, run, _run_style(th, base, bold, italic, strike))
    return out
}

// Which inline marker starts at i: 1 strike, 2 bold, 3 italic, 4 code,
// 5 link, 0 plain text. One decision point keeps the scan loop readable.
fun _marker(text: str, i: int, italic: bool) -> int {
    if _at(text, i, "~~") {
        return 1
    }
    if _at(text, i, "**") {
        return 2
    }
    if _star_toggle(text, i, italic) {
        return 3
    }
    if _at(text, i, "`") {
        return 4
    }
    if _at(text, i, "[") {
        return 5
    }
    return 0
}

// Lay spans out at `width` columns with a greedy word wrap. `first` and
// `rest` are prefix spans (a bullet and its hanging indent, a quote bar);
// every produced line starts with one of them. A word wider than a whole
// line is hard-split by columns so nothing overflows.
fun wrap_spans(spans: list[Span], max: int, first: list[Span], rest: list[Span]) -> list[Line] {
    let out: list[Line] = []
    let words = _words(spans)
    var cur = _copy_spans(first)
    var cur_w = _spans_width(first)
    var has_word = false
    var wi = 0
    while wi < words.len() {
        let word = words[wi]
        let ww = _word_width(word)
        var sep = 0
        if has_word {
            sep = 1
        }
        var avail = max - _spans_width(rest)
        if avail < 8 {
            avail = 8
        }
        if ww > avail {
            // Hard-split an over-wide word (a long path, a URL) into
            // line-sized pieces, keeping each segment's style.
            if has_word {
                out.push(Line.from_spans(cur))
                cur = _copy_spans(rest)
                cur_w = _spans_width(rest)
                has_word = false
            }
            var p = 0
            while p < word.parts.len() {
                let pieces = _split_columns(word.parts[p].text, avail)
                var q = 0
                while q < pieces.len() {
                    let pw = width(pieces[q])
                    if has_word and cur_w + pw > max {
                        out.push(Line.from_spans(cur))
                        cur = _copy_spans(rest)
                        cur_w = _spans_width(rest)
                    }
                    cur.push(Span.styled(pieces[q], word.parts[p].style))
                    cur_w = cur_w + pw
                    has_word = true
                    q = q + 1
                }
                p = p + 1
            }
        } else {
            if cur_w + sep + ww > max and has_word {
                out.push(Line.from_spans(cur))
                cur = _copy_spans(rest)
                cur_w = _spans_width(rest)
                _push_word(cur, word, false)
                cur_w = cur_w + ww
            } else {
                _push_word(cur, word, has_word)
                cur_w = cur_w + sep + ww
            }
            has_word = true
        }
        wi = wi + 1
    }
    out.push(Line.from_spans(cur))
    return out
}

// A word: a run of non-space text, possibly crossing style boundaries
// ("**bold**," is one word whose comma is a second, plain-styled part).
// Keeping the parts together is what stops punctuation drifting away from
// the styled run it follows.
class Word {
    parts: list[Span]
}

class LinkParse {
    ok: bool
    label: str
    url: str
    next: int
}

// Split spans into words. A space anywhere ends the current word; a style
// boundary with no space between continues it, so adjacent spans glue into
// one word with multiple styled parts.
fun _words(spans: list[Span]) -> list[Word] {
    let out: list[Word] = []
    var open = false
    var s = 0
    while s < spans.len() {
        let text = spans[s].text
        if text != "" {
            let parts = text.split(" ")
            var p = 0
            while p < parts.len() {
                if parts[p] != "" {
                    let seg = Span.styled(parts[p], spans[s].style)
                    if p == 0 and open {
                        out[out.len() - 1].parts.push(seg)
                    } else {
                        let fresh: list[Span] = [seg]
                        out.push(Word(parts: fresh))
                    }
                }
                p = p + 1
            }
            open = not text.ends_with(" ")
        }
        s = s + 1
    }
    return out
}

fun _word_width(w: Word) -> int {
    return _spans_width(w.parts)
}

// Append a word's parts to the line, with a leading space folded into the
// first part when the line already has content.
fun _push_word(cur: list[Span], w: Word, lead_space: bool) {
    var p = 0
    while p < w.parts.len() {
        var t = w.parts[p].text
        if p == 0 and lead_space {
            t = " ${t}"
        }
        cur.push(Span.styled(t, w.parts[p].style))
        p = p + 1
    }
    return
}

fun _copy_spans(src: list[Span]) -> list[Span] {
    let out: list[Span] = []
    var i = 0
    while i < src.len() {
        out.push(src[i])
        i = i + 1
    }
    return out
}

fun _spans_width(spans: list[Span]) -> int {
    var total = 0
    var i = 0
    while i < spans.len() {
        total = total + width(spans[i].text)
        i = i + 1
    }
    return total
}

// Break text into pieces of at most `cols` display columns.
fun _split_columns(text: str, cols: int) -> list[str] {
    let out: list[str] = []
    var piece = ""
    var piece_w = 0
    var i = 0
    while i < text.length() {
        let c = decode(text, i)
        if piece_w + c.width > cols and piece != "" {
            out.push(piece)
            piece = ""
            piece_w = 0
        }
        piece = piece.concat(text.substring(i, i + c.size))
        piece_w = piece_w + c.width
        i = i + c.size
    }
    if piece != "" {
        out.push(piece)
    }
    return out
}

fun _run_style(th: MdTheme, base: Style, bold: bool, italic: bool, strike: bool) -> Style {
    var s = base
    if bold and italic {
        s = th.bold.italic()
    } else {
        if bold {
            s = th.bold
        } else {
            if italic {
                s = th.italic
            }
        }
    }
    if strike {
        s = s.strike()
    }
    return s
}

// Push the finished run as a span and hand back an empty run.
fun _flush(out: list[Span], run: str, style: Style) -> str {
    if run != "" {
        out.push(Span.styled(run, style))
    }
    return ""
}

fun _at(text: str, i: int, marker: str) -> bool {
    let end = i + marker.length()
    if end > text.length() {
        return false
    }
    return text.substring(i, end) == marker
}

// A single * toggles italic only when it hugs the word: opening with a
// non-space after it, closing with a non-space before it. "2 * 3" and a
// bare asterisk stay literal.
fun _star_toggle(text: str, i: int, italic: bool) -> bool {
    if not _at(text, i, "*") {
        return false
    }
    if _at(text, i, "**") {
        return false
    }
    if italic {
        if i == 0 {
            return false
        }
        return text.substring(i - 1, i) != " "
    }
    if i + 1 >= text.length() {
        return false
    }
    let after = text.substring(i + 1, i + 2)
    return after != " " and after != "*"
}

fun _find(text: str, needle: str, from: int) -> int {
    var i = from
    while i < text.length() {
        if _at(text, i, needle) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// [label](url) starting at i. ok is false when the shape is incomplete, and
// the bracket is treated as plain text.
fun _parse_link(text: str, i: int) -> LinkParse {
    let miss = LinkParse(ok: false, label: "", url: "", next: i)
    let close = _find(text, "]", i + 1)
    if close < 0 {
        return miss
    }
    if not _at(text, close + 1, "(") {
        return miss
    }
    let end = _find(text, ")", close + 2)
    if end < 0 {
        return miss
    }
    return LinkParse(
        ok: true,
        label: text.substring(i + 1, close),
        url: text.substring(close + 2, end),
        next: end + 1,
    )
}
