// magpie: markdown rendered into plumage lines for terminal display.
//
//     from "github.com/martian56/magpie" import render
//     from "github.com/martian56/magpie/theme" import MdTheme, default_theme
//
//     let lines = render(markdown, 72, default_theme())
//     // lines are plumage text Lines: draw them with Paragraph.from_lines,
//     // or walk the styled spans yourself.
//
// The dialect is the line-oriented subset that model and tool output
// actually uses: headings, paragraphs with **bold**, *italic*, `code`, and
// [text](url), fenced code blocks, bullet and numbered lists (nesting by
// indentation), blockquotes, and horizontal rules. Everything is wrapped to
// the given width, code blocks hard-split so nothing overflows, and an
// unclosed fence renders as code, which is what a streaming reply looks
// like before its closing fence arrives.

import std.string
from "github.com/martian56/wingspan" import decode, width
from "github.com/martian56/plumage/text" import Span, Line
from "./theme" import MdTheme, default_theme
from "./inline" import parse_inline, wrap_spans, _split_columns

fun render(md: str, max: int, th: MdTheme) -> list[Line] {
    let out: list[Line] = []
    var para = ""
    var table: list[str] = []
    var quote: list[str] = []
    var in_fence = false
    var fence_lang = ""
    let lines = md.lines()
    var i = 0
    while i < lines.len() {
        let raw = lines[i]
        let trimmed = raw.trim()
        if not in_fence and table.len() > 0 and not trimmed.starts_with("|") {
            table = _flush_table(out, table, max, th)
        }
        if not in_fence and quote.len() > 0 and not trimmed.starts_with(">") {
            quote = _flush_quote(out, quote, max, th)
        }
        if in_fence {
            if _is_fence(trimmed) {
                in_fence = false
            } else {
                _push_code(out, raw, max, th, fence_lang)
            }
        } else {
            if trimmed.starts_with("|") {
                para = _flush_para(out, para, max, th)
                table.push(trimmed)
            } else {
                if _is_fence(trimmed) {
                    para = _flush_para(out, para, max, th)
                    in_fence = true
                    fence_lang = _fence_lang(trimmed)
                } else {
                    if trimmed == "" {
                        para = _flush_para(out, para, max, th)
                        _push_blank(out)
                    } else {
                        if _heading_level(trimmed) > 0 {
                            para = _flush_para(out, para, max, th)
                            _push_heading(out, trimmed, max, th)
                        } else {
                            if _is_rule(trimmed) {
                                para = _flush_para(out, para, max, th)
                                out.push(Line.styled(_repeat("─", max), th.rule))
                            } else {
                                if trimmed.starts_with(">") {
                                    para = _flush_para(out, para, max, th)
                                    quote.push(_quote_body(trimmed))
                                } else {
                                    if _bullet_body(raw) != "" {
                                        para = _flush_para(out, para, max, th)
                                        _push_bullet(out, raw, max, th)
                                    } else {
                                        if _number_len(trimmed) > 0 {
                                            para = _flush_para(out, para, max, th)
                                            _push_numbered(out, raw, trimmed, max, th)
                                        } else {
                                            if para == "" {
                                                para = trimmed
                                            } else {
                                                para = "${para} ${trimmed}"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    let _ = _flush_para(out, para, max, th)
    let _ = _flush_table(out, table, max, th)
    let _ = _flush_quote(out, quote, max, th)
    return out
}

// The content of one quote line: the > stripped, one following space eaten,
// deeper indentation kept so nested bullets survive.
fun _quote_body(trimmed: str) -> str {
    var t = trimmed.substring(1, trimmed.length())
    if t.starts_with(" ") {
        t = t.substring(1, t.length())
    }
    return t
}

// A run of quote lines rendered as a nested document behind the bar: the
// inner content goes through the full block pass (headings, lists, code,
// even another quote), narrowed by the bar's width, with the quote tone as
// its base text style.
fun _flush_quote(out: list[Line], quote: list[str], max: int, th: MdTheme) -> list[str] {
    let empty: list[str] = []
    if quote.len() == 0 {
        return empty
    }
    var inner = ""
    var i = 0
    while i < quote.len() {
        if i > 0 {
            inner = "${inner}\n${quote[i]}"
        } else {
            inner = quote[i]
        }
        i = i + 1
    }
    let inner_th = MdTheme(
        text: th.quote,
        heading: th.heading,
        bold: th.bold,
        italic: th.italic,
        code: th.code,
        code_block: th.code_block,
        bullet: th.bullet,
        quote: th.quote,
        rule: th.rule,
        link: th.link,
        url: th.url,
        ins: th.ins,
        del: th.del,
    )
    var narrowed = max - 2
    if narrowed < 8 {
        narrowed = 8
    }
    let rendered = render(inner, narrowed, inner_th)
    i = 0
    while i < rendered.len() {
        let spans: list[Span] = [Span.styled("▎ ", th.quote)]
        var s = 0
        while s < rendered[i].spans.len() {
            spans.push(rendered[i].spans[s])
            s = s + 1
        }
        out.push(Line.from_spans(spans))
        i = i + 1
    }
    return empty
}

// The language tag on a fence line ("```diff" gives "diff"), "" when bare.
fun _fence_lang(trimmed: str) -> str {
    return trimmed.substring(3, trimmed.length()).trim().to_lower()
}

// The plain text of one rendered line, spans joined. For callers that need
// the unstyled form (selection copy, tests).
fun plain(line: Line) -> str {
    var s = ""
    var i = 0
    while i < line.spans.len() {
        s = s.concat(line.spans[i].text)
        i = i + 1
    }
    return s
}

fun _flush_para(out: list[Line], para: str, max: int, th: MdTheme) -> str {
    if para == "" {
        return ""
    }
    let none: list[Span] = []
    let wrapped = wrap_spans(parse_inline(para, th, th.text), max, none, none)
    var i = 0
    while i < wrapped.len() {
        out.push(wrapped[i])
        i = i + 1
    }
    return ""
}

fun _push_blank(out: list[Line]) {
    if out.len() == 0 {
        return
    }
    if plain(out[out.len() - 1]) == "" {
        return
    }
    out.push(Line.raw(""))
    return
}

fun _push_heading(out: list[Line], trimmed: str, max: int, th: MdTheme) {
    let level = _heading_level(trimmed)
    let content = trimmed.substring(level, trimmed.length()).trim()
    let none: list[Span] = []
    let spans: list[Span] = [Span.styled(content, th.heading)]
    let wrapped = wrap_spans(spans, max, none, none)
    var i = 0
    while i < wrapped.len() {
        out.push(wrapped[i])
        i = i + 1
    }
    return
}

fun _push_bullet(out: list[Line], raw: str, max: int, th: MdTheme) {
    let indent = _leading_spaces(raw)
    var content = _bullet_body(raw)
    // Task-list items render their box as a checkbox glyph.
    var marker = "• "
    if content.starts_with("[x] ") or content.starts_with("[X] ") {
        marker = "☑ "
        content = content.substring(4, content.length()).trim()
    } else {
        if content.starts_with("[ ] ") {
            marker = "☐ "
            content = content.substring(4, content.length()).trim()
        }
    }
    let first: list[Span] = [Span.raw(indent), Span.styled(marker, th.bullet)]
    let rest: list[Span] = [Span.raw("${indent}  ")]
    let wrapped = wrap_spans(parse_inline(content, th, th.text), max, first, rest)
    var i = 0
    while i < wrapped.len() {
        out.push(wrapped[i])
        i = i + 1
    }
    return
}

// A run of |-delimited rows rendered as a padded table: cells inline-parsed,
// columns sized to their widest cell, the ---/:---: separator row consumed
// for alignment (left, right, or center) and drawn as a rule between header
// and body. A line wider than the width is clipped rather than wrapped, so
// a table never breaks its own grid.
fun _flush_table(out: list[Line], table: list[str], max: int, th: MdTheme) -> list[str] {
    let empty: list[str] = []
    if table.len() == 0 {
        return empty
    }
    let rows: list[list[str]] = []
    var aligns: list[int] = []
    var sep_after_header = false
    var r = 0
    while r < table.len() {
        let cells = _row_cells(table[r])
        if r == 1 and _is_sep_row(cells) {
            aligns = _aligns_of(cells)
            sep_after_header = true
        } else {
            rows.push(cells)
        }
        r = r + 1
    }
    if rows.len() == 0 {
        return empty
    }
    // Column count and widths from the parsed cells' plain text.
    var ncols = 0
    var ri = 0
    while ri < rows.len() {
        if rows[ri].len() > ncols {
            ncols = rows[ri].len()
        }
        ri = ri + 1
    }
    let widths: list[int] = []
    var c = 0
    while c < ncols {
        var best = 1
        ri = 0
        while ri < rows.len() {
            if c < rows[ri].len() {
                let w = _plain_width(_cell_spans(rows[ri][c], ri, sep_after_header, th))
                if w > best {
                    best = w
                }
            }
            ri = ri + 1
        }
        widths.push(best)
        c = c + 1
    }
    ri = 0
    while ri < rows.len() {
        let spans: list[Span] = []
        c = 0
        while c < ncols {
            if c > 0 {
                spans.push(Span.styled(" │ ", th.rule))
            }
            var cell = ""
            if c < rows[ri].len() {
                cell = rows[ri][c]
            }
            let cs = _cell_spans(cell, ri, sep_after_header, th)
            _pad_into(spans, cs, widths[c], _align_of(aligns, c))
            c = c + 1
        }
        out.push(Line.from_spans(_clip_spans(spans, max)))
        if ri == 0 and sep_after_header {
            out.push(Line.styled(_clip_text(_sep_line(widths), max), th.rule))
        }
        ri = ri + 1
    }
    return empty
}

// "| a | b |" into trimmed cell texts. A backslash-escaped pipe is cell
// content, not a boundary, so "a \| b" stays one cell holding "a | b".
fun _row_cells(line: str) -> list[str] {
    var t = line
    if t.starts_with("|") {
        t = t.substring(1, t.length())
    }
    if t.ends_with("|") and not t.ends_with("\\|") {
        t = t.substring(0, t.length() - 1)
    }
    let out: list[str] = []
    var cell = ""
    var i = 0
    while i < t.length() {
        let ch = t.substring(i, i + 1)
        if ch == "\\" and i + 1 < t.length() and t.substring(i + 1, i + 2) == "|" {
            cell = cell.concat("|")
            i = i + 2
        } else {
            if ch == "|" {
                out.push(cell.trim())
                cell = ""
                i = i + 1
            } else {
                cell = cell.concat(ch)
                i = i + 1
            }
        }
    }
    out.push(cell.trim())
    return out
}

// A separator row: every cell is dashes with optional edge colons.
fun _is_sep_row(cells: list[str]) -> bool {
    if cells.len() == 0 {
        return false
    }
    var i = 0
    while i < cells.len() {
        if not _is_sep_cell(cells[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

fun _is_sep_cell(cell: str) -> bool {
    if cell == "" {
        return false
    }
    var saw_dash = false
    var i = 0
    while i < cell.length() {
        let ch = cell.substring(i, i + 1)
        if ch == "-" {
            saw_dash = true
        } else {
            if ch != ":" {
                return false
            }
        }
        i = i + 1
    }
    return saw_dash
}

// 0 left, 1 right, 2 center, from the separator row's colons.
fun _aligns_of(cells: list[str]) -> list[int] {
    let out: list[int] = []
    var i = 0
    while i < cells.len() {
        let cell = cells[i]
        let left = cell.starts_with(":")
        let right = cell.ends_with(":")
        if left and right {
            out.push(2)
        } else {
            out.push(1) if right else out.push(0)
        }
        i = i + 1
    }
    return out
}

fun _align_of(aligns: list[int], c: int) -> int {
    if c < aligns.len() {
        return aligns[c]
    }
    return 0
}

// A cell's styled spans: the header row (when a separator followed it) is
// bold, body cells parse against the plain text base.
fun _cell_spans(cell: str, row: int, has_header: bool, th: MdTheme) -> list[Span] {
    var base = th.text
    if row == 0 and has_header {
        base = th.bold
    }
    return parse_inline(cell, th, base)
}

fun _plain_width(spans: list[Span]) -> int {
    var total = 0
    var i = 0
    while i < spans.len() {
        total = total + width(spans[i].text)
        i = i + 1
    }
    return total
}

// The cell spans padded to the column width under its alignment.
fun _pad_into(spans: list[Span], cs: list[Span], col_w: int, align: int) {
    let w = _plain_width(cs)
    var gap = col_w - w
    if gap < 0 {
        gap = 0
    }
    var before = 0
    if align == 1 {
        before = gap
    }
    if align == 2 {
        before = gap / 2
    }
    if before > 0 {
        spans.push(Span.raw(_repeat(" ", before)))
    }
    var i = 0
    while i < cs.len() {
        spans.push(cs[i])
        i = i + 1
    }
    if gap - before > 0 {
        spans.push(Span.raw(_repeat(" ", gap - before)))
    }
    return
}

// The rule drawn between header and body: dashes per column, joined at the
// cell borders.
fun _sep_line(widths: list[int]) -> str {
    var out = ""
    var i = 0
    while i < widths.len() {
        if i > 0 {
            out = out.concat("─┼─")
        }
        out = out.concat(_repeat("─", widths[i]))
        i = i + 1
    }
    return out
}

// Clip spans to at most `max` display columns.
fun _clip_spans(spans: list[Span], max: int) -> list[Span] {
    let out: list[Span] = []
    var used = 0
    var i = 0
    while i < spans.len() {
        let t = spans[i].text
        let w = width(t)
        if used + w <= max {
            out.push(spans[i])
            used = used + w
        } else {
            let room = max - used
            if room > 0 {
                out.push(Span.styled(_clip_text(t, room), spans[i].style))
            }
            return out
        }
        i = i + 1
    }
    return out
}

fun _clip_text(t: str, max: int) -> str {
    var out = ""
    var used = 0
    var i = 0
    while i < t.length() {
        let c = decode(t, i)
        if used + c.width > max {
            return out
        }
        out = out.concat(t.substring(i, i + c.size))
        used = used + c.width
        i = i + c.size
    }
    return out
}

fun _push_numbered(out: list[Line], raw: str, trimmed: str, max: int, th: MdTheme) {
    let indent = _leading_spaces(raw)
    let nlen = _number_len(trimmed)
    let marker = trimmed.substring(0, nlen)
    let content = trimmed.substring(nlen, trimmed.length()).trim()
    let first: list[Span] = [Span.raw(indent), Span.styled("${marker} ", th.bullet)]
    let rest: list[Span] = [Span.raw("${indent}${_repeat(" ", width(marker) + 1)}")]
    let wrapped = wrap_spans(parse_inline(content, th, th.text), max, first, rest)
    var i = 0
    while i < wrapped.len() {
        out.push(wrapped[i])
        i = i + 1
    }
    return
}

// One code line, verbatim under a two-column indent, hard-split at the
// width so long lines cannot overflow the transcript. In a ```diff fence,
// added and removed lines take the ins and del styles.
fun _push_code(out: list[Line], raw: str, max: int, th: MdTheme, lang: str) {
    var style = th.code_block
    if lang == "diff" {
        if raw.starts_with("+") {
            style = th.ins
        }
        if raw.starts_with("-") {
            style = th.del
        }
    }
    var avail = max - 2
    if avail < 8 {
        avail = 8
    }
    if raw == "" {
        out.push(Line.from_spans([Span.raw("  "), Span.styled("", style)]))
        return
    }
    let pieces = _split_columns(raw, avail)
    var i = 0
    while i < pieces.len() {
        out.push(Line.from_spans([Span.raw("  "), Span.styled(pieces[i], style)]))
        i = i + 1
    }
    return
}

fun _is_fence(trimmed: str) -> bool {
    return trimmed.starts_with("```") or trimmed.starts_with("~~~")
}

// 1 to 6 leading #s followed by a space; 0 when the line is not a heading.
fun _heading_level(trimmed: str) -> int {
    var level = 0
    while level < trimmed.length() and level < 6 and trimmed.substring(level, level + 1) == "#" {
        level = level + 1
    }
    if level == 0 {
        return 0
    }
    if level >= trimmed.length() {
        return 0
    }
    if trimmed.substring(level, level + 1) != " " {
        return 0
    }
    return level
}

// Three or more of the same rule character and nothing else.
fun _is_rule(trimmed: str) -> bool {
    if trimmed.length() < 3 {
        return false
    }
    let first = trimmed.substring(0, 1)
    if first != "-" and first != "*" and first != "_" {
        return false
    }
    var i = 0
    while i < trimmed.length() {
        if trimmed.substring(i, i + 1) != first {
            return false
        }
        i = i + 1
    }
    return true
}

// The item text of a "- ", "* ", or "+ " bullet line, "" when the line is
// not a bullet.
fun _bullet_body(raw: str) -> str {
    let t = raw.trim()
    if t.starts_with("- ") or t.starts_with("* ") or t.starts_with("+ ") {
        return t.substring(2, t.length()).trim()
    }
    return ""
}

// Byte length of a "12." numbered-list marker, 0 when the line is not one.
fun _number_len(trimmed: str) -> int {
    var i = 0
    while i < trimmed.length() and _is_digit(trimmed.substring(i, i + 1)) {
        i = i + 1
    }
    if i == 0 {
        return 0
    }
    if not _at_str(trimmed, i, ". ") {
        return 0
    }
    return i + 1
}

fun _is_digit(c: str) -> bool {
    return c >= "0" and c <= "9"
}

fun _at_str(text: str, i: int, marker: str) -> bool {
    let end = i + marker.length()
    if end > text.length() {
        return false
    }
    return text.substring(i, end) == marker
}

fun _leading_spaces(raw: str) -> str {
    var i = 0
    while i < raw.length() and raw.substring(i, i + 1) == " " {
        i = i + 1
    }
    return raw.substring(0, i)
}

fun _repeat(s: str, n: int) -> str {
    var out = ""
    var i = 0
    while i < n {
        out = out.concat(s)
        i = i + 1
    }
    return out
}
